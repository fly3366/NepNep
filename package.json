{
  "name": "nepnep",
  "private": true,
  "version": "0.1.6",
  "description": "Real-time speech-to-text and AI translation desktop app powered by Qwen-Omni",
  "license": "MIT",
  "author": {
    "name": "NepNep Contributors"
  },
  "homepage": "https://github.com/fly3366/NepNep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fly3366/NepNep.git"
  },
  "bugs": {
    "url": "https://github.com/fly3366/NepNep/issues"
  },
  "keywords": [
    "electron",
    "vue",
    "translation",
    "speech-to-text",
    "real-time",
    "subtitle",
    "qwen",
    "qwen-omni",
    "dashscope",
    "desktop-app"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist-electron && vue-tsc && vite build && electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "naive-ui": "^2.38.2",
    "vfonts": "^0.0.3",
    "vue": "^3.5.40",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/audioworklet": "^0.0.100",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "icon-gen": "^5.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "build": {
    "appId": "io.nepnep.desktop",
    "productName": "nepnep",
    "asar": true,
    "copyright": "© 2024-2026 NepNep Contributors",
    "icon": "logo.png",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "./dist",
      "./dist-electron",
      "./package.json",
      "./logo.png"
    ],
    "mac": {
      "artifactName": "${productName}_${version}_macos_${arch}.${ext}",
      "icon": "logo.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "${productName}_${version}_windows_${arch}.${ext}",
      "icon": "public/images/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "public/images/logo.ico",
      "uninstallerIcon": "public/images/logo.ico"
    },
    "linux": {
      "artifactName": "${productName}_${version}_linux_${arch}.${ext}",
      "icon": "logo.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "releaseInfo": {
      "releaseNotes": "ChangeLog"
    },
    "publish": null
  }
}
